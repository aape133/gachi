{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gachi",
  "version": "0.2.8",
  "identifier": "app.gachi.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md",
      "../ui/fonts/LICENSE.txt": "LICENSE-Pretendard.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "저지연 P2P 합주",
    "longDescription": "친구들과 인터넷으로 같이 연주하고 노래하는 저지연 P2P 합주 앱",
    "category": "Music",
    "copyright": "gachi",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "./installer.nsi",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gachi"
        ]
      }
    }
  }
}
