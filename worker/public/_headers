# the landing page's files: not to be framed by another site, sniffed as another type, or
# told where a visitor came from beyond the site itself
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'

# the page's own files: kept a year by browsers. The pages (asked for anew each visit)
# refer to them with a version stamp (scripts/stamp.mjs), so a changed file gets a new
# address; the font's pieces (fonts/subset) never change under the same name.
/style.css
  Cache-Control: public, max-age=31536000, immutable
/main.js
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
